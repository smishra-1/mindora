# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel AI Gateway: chat replies, mood guessing and pattern notes.
# Without it, Mindora uses its built-in rule-based replies.
AI_GATEWAY_API_KEY=
# Optional: override the model (AI Gateway "provider/model" id)
# MINDORA_MODEL=anthropic/claude-haiku-5.5
